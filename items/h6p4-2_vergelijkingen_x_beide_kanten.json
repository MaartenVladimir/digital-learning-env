    "sympy_str": "{{a}}*x + {{b}} = {{c}}*x + {{d}}",
    "goal": "solve_equation",
    "is_crisis": true,
    "post_crisis": {
      "explanation": "Wanneer je een vergelijking met breuken hebt, is het vaak handiger de breuken eerst weg te werken! Je kan dit doen door beide kanten met hetzelfde getal te vermenigvuldigen.",
      "explanation_latex": [
        "\\begin{array}{l}",
        "\\frac{1}{3}x + \\frac{2}{6} = -\\frac{3}{4}x + 2 \\\\ \\\\",
        "\\text{Alles met 12 vermenigvuldigen} \\\\ \\\\",
        "4x + 4 = -9x + 24 \\\\",
        "13x + 4 = 24 \\\\",
        "13x = 20 \\\\",
        "x = \\frac{20}{13}",
        "\\end{array}"
      ]
    },
    "params": {
      "a":     {"int": [2, 8]},
      "c":     {"int": [2, 8], "exclude": ["a"]},
      "b":     {"fraction": {"lcd": 6}},
      "d":     {"fraction": {"lcd": 6, "negative": true, "exclude_noemer": ["b"]}},
      "x_sol": "(d - b) / (a - c)"
    }
  },
