    "id": "d11_crisis_a(x+b)=c",
    "form": "a(x + b) = c",
    "display": "{{a}}(x {{b:term}}) = {{c}}",
    "sympy_str": "{{a}}*(x + {{b}}) = {{c}}",
    "goal": "solve_equation",
    "is_crisis": true,
    "post_crisis": {
      "explanation": "Als je een vergelijking met haakjes hebt, kan je die eerst weghalen met de bordjesmethode. Een voorbeeld:"      ,
      "explanation_latex": [
        "\\begin{array}{l}",
        " \\text{Los op: } 2(x-3) = 30 \\\\ \\\\",
        " \\text{Leg een } \\emph{bordje } \\text{(of je vinger) op de haakjes } (x - 3) \\\\",
        " \\text{Je vergelijking is dan: } 2 \\cdot \\text{bordje} = 30 \\\\ ",
        " \\text{Wat moet er dan onder het bordje staan, zodat de vergelijking klopt?} \\\\",
        " 15 \\text{! Want } 2\\cdot 15 = 30  \\\\",
        " \\\\",
        " \\text{Je lost de vergelijking dus als volgt op:} \\\\", 
        " 2(x-3) = 30\\\\",
        " x - 3 = 15\\\\",
        " x = 18\\\\",
        " \\\\",
        "\\end{array}"
      ]
    },
    "params": {
      "a":     {"int": [2, 7]},
      "b":     {"int": [1, 9]},
      "multiple": {"int": [2, 6]},
      "c":       "a * multiple",
      "x_sol":   "(c - b) / a"
    }
  },
